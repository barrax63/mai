    {
      "parameters": {
        "jsCode": "// Pair each Discord lookup result with the queue row that produced it.\n// itemMatching() follows n8n's item lineage and stays correct even when\n// Check Pending Message failed for some items (continueOnFail).\nconst results = $input.all();\n\nreturn results.map((result, index) => {\n  const row = $('Get Due Warnings').itemMatching(index).json;\n  const lookup = result.json ?? {};\n  const exists = lookup.id === row.messageId;\n\n  let categories = [];\n  try {\n    const parsed = JSON.parse(row.categories ?? '[]');\n    if (Array.isArray(parsed)) categories = parsed.filter(Boolean);\n  } catch {}\n\n  // Resolve raw mention markup to readable names — the warning DM renders\n  // content as plain text, so <@id> would show up literally. User names come\n  // from the lookup's mentions array (requires the non-simplified message\n  // object); roles/channels carry no name data here -> generic label.\n  let content = exists ? String(lookup.content ?? '') : '';\n  if (content) {\n    const mentionNames = new Map(\n      (lookup.mentions ?? []).map(user => [String(user.id), user.global_name ?? user.username])\n    );\n    content = content\n      .replace(/<@!?(\\d+)>/g, (match, id) => '@' + (mentionNames.get(id) ?? 'Unbekannt'))\n      .replace(/<@&(\\d+)>/g, '@Rolle')\n      .replace(/<#(\\d+)>/g, '#Kanal');\n  }\n\n  return {\n    json: {\n      messageId: row.messageId,\n      guildId: row.guildId,\n      channelId: row.channelId,\n      userId: row.userId,\n      categories,\n      scoldMessageId: String(row.scoldMessageId ?? '').trim(),\n      content,\n      timestamp: exists ? lookup.timestamp : null,\n      exists\n    }\n  };\n});"
      },

    {
      "parameters": {
        "jsCode": "const deleted = $('Route Pending Record').all()\n  .map(item => item.json)\n  .filter(message => message.exists === true);\n\nconst byUser = new Map();\n\nfor (const message of deleted) {\n  if (!byUser.has(message.userId)) {\n    byUser.set(message.userId, {\n      userId: message.userId,\n      guildId: message.guildId,\n      violations: [],\n      categories: new Set()\n    });\n  }\n\n  const group = byUser.get(message.userId);\n  group.violations.push(message);\n\n  for (const category of message.categories ?? []) {\n    if (category) group.categories.add(category);\n  }\n}\n\nconst sanitize = value => String(value ?? '')\n  .replace(/@/g, '@\\u200b')\n  .replace(/\\r?\\n/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst config = $('Central Config').first().json;\n\nconst formatTimestamp = value => {\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return 'Unbekannter Zeitpunkt';\n\n  return new Intl.DateTimeFormat('de-DE', {\n    timeZone: config.timezone ?? 'Europe/Berlin',\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit'\n  }).format(date);\n};\n\nreturn [...byUser.values()].map(group => {\n  const categoryText = group.categories.size\n    ? [...group.categories].join(', ')\n    : 'Nicht näher spezifiziert';\n\n  const header = [\n    '# Verwarnung',\n    '',\n    'Mindestens eine deiner Nachrichten hat gegen die Serverregeln verstoßen und wurde entfernt.',\n    '',\n    `**Kategorie:** ${categoryText}`,\n    '',\n    '**Entfernte Nachrichten:**'\n  ].join('\\n');\n\n  const footer = `\\n\\n${config.warningFooter ?? ''}`;\n  const maxLength = 1900;\n  const lines = [];\n  let omitted = 0;\n\n  for (let index = 0; index < group.violations.length; index++) {\n    const violation = group.violations[index];\n    const content = sanitize(violation.content).slice(0, 500);\n    const line = `> [${formatTimestamp(violation.timestamp)}] ${content || '(Leere Nachricht)'}`;\n    const candidate = `${header}\\n${[...lines, line].join('\\n')}${footer}`;\n\n    if (candidate.length > maxLength) {\n      omitted = group.violations.length - index;\n      break;\n    }\n\n    lines.push(line);\n  }\n\n  if (omitted > 0) {\n    const omittedLine = `> … und ${omitted} weitere Nachricht${omitted === 1 ? '' : 'en'}.`;\n    if (`${header}\\n${[...lines, omittedLine].join('\\n')}${footer}`.length <= maxLength) {\n      lines.push(omittedLine);\n    }\n  }\n\n  return {\n    json: {\n      userId: group.userId,\n      guildId: group.guildId,\n      violationCount: group.violations.length,\n      categories: [...group.categories],\n      warningContent: `${header}\\n${lines.join('\\n')}${footer}`.slice(0, maxLength)\n    }\n  };\n});"
      },

      "parameters": {
        "jsCode": "// Guild targeting lives in the bot (DISCORD_GUILD_IDS) and in the queue\n// rows (guildId column). Only presentation knobs remain here.\nconst config = {\n  timezone: 'Europe/Berlin',\n  warningFooter: '*Habe ich einen Fehler gemacht? Dann bitte Info an einen Admin.*',\n\n  // Privacy-preserving queue\n  // Must match the webhook workflow. Increment the suffix whenever the\n  // queue schema changes.\n  queueTableName: 'Discord Server Moderation v3'\n};\n\nif (!config.queueTableName?.trim()) {\n  throw new Error('Central Config: queueTableName is required.');\n}\n\nreturn [{ json: config }];"
      },

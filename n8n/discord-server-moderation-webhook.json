{
  "name": "Discord Server Moderation (Check Messages)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Guild targeting lives in the bot (DISCORD_GUILD_IDS); the workflow\n// moderates whatever the bot forwards. Only behavior knobs remain here.\nconst config = {\n  gracePeriodMinutes: 10,\n  warningEmoji: '😡',\n\n  // Scold replies: one random line is posted as a reply to every flagged\n  // message, right after the warning reaction.\n  flagReplies: [\n    'Pass auf was du sagst du Wicht.',\n    'Sooo nicht Sportsfreund.',\n    'Noch so n Spruch, Jochbeinbruch.',\n    'Noch so n Ding, Augenring.',\n    'Lösch das.'\n  ],\n\n  // Privacy-preserving queue\n  // Increment the suffix whenever the queue schema changes.\n  queueTableName: 'Discord Server Moderation v3'\n};\n\nif (!Number.isInteger(config.gracePeriodMinutes) || config.gracePeriodMinutes < 1) {\n  throw new Error('Central Config: gracePeriodMinutes must be a positive integer.');\n}\nif (!config.warningEmoji?.trim() || !config.queueTableName?.trim()) {\n  throw new Error('Central Config: warningEmoji and queueTableName are required.');\n}\nif (!Array.isArray(config.flagReplies) || config.flagReplies.length === 0 || config.flagReplies.some((line) => typeof line !== 'string' || !line.trim())) {\n  throw new Error('Central Config: flagReplies must be a non-empty array of non-empty strings.');\n}\n\nreturn [{ json: config }];"
      },
      "id": "ab6cb6db-8ebb-47e9-af9d-2715402f8378",
      "name": "Central Config",

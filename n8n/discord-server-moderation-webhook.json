    {
      "parameters": {
        "jsCode": "// One webhook call = one message. Message identity comes from the webhook\n// body; the classification result (flagged categories) comes from the\n// Violation? branch input.\nconst config = $('Central Config').first().json;\nconst body = $('Webhook').first().json.body;\nconst classification = $input.first().json;\n\nif (!body?.messageId || !body?.guildId || !body?.channelId || !body?.userId) {\n  throw new Error('Prepare Queue Metadata: webhook body is missing messageId/guildId/channelId/userId.');\n}\n\n// The classify operation returns categories as an object of booleans,\n// e.g. { harassment: true, hate: false, ... } -> keep only flagged names.\nconst categories = Object.entries(classification.categories ?? {})\n  .filter(([, isFlagged]) => isFlagged === true)\n  .map(([category]) => category);\n\nconst now = new Date();\nconst dueAt = new Date(now.getTime() + config.gracePeriodMinutes * 60 * 1000);\n\nreturn [{\n  json: {\n    messageId: String(body.messageId),\n    guildId: String(body.guildId),\n    channelId: String(body.channelId),\n    userId: String(body.userId),\n    categoriesJson: JSON.stringify(categories),\n    warnedAt: now.toISOString(),\n    dueAt: dueAt.toISOString()\n  }\n}];"
      },

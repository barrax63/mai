# --- n8n moderation webhook (public URL) ---
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/<webhook-path>

# Header name for the auth secret, sent as "<header>: <secret>" (n8n header auth)
N8N_WEBHOOK_HEADER=X-API-Key
N8N_WEBHOOK_SECRET=
# Max wait for the workflow's "Respond to Webhook" answer (ms)
N8N_WEBHOOK_TIMEOUT_MS=30000

# --- Mai chat workflow (mention/reply conversations) ---
# Production webhook URL of the "Mai Chat" workflow. Unset = chat disabled.
# Uses the same auth header/secret as the moderation webhook.
N8N_CHAT_WEBHOOK_URL=

# --- Discord application (Developer Portal -> your app) ---
# Bot -> Token
DISCORD_BOT_TOKEN=
# General Information -> Public Key (verifies interaction signatures)
DISCORD_PUBLIC_KEY=
# General Information -> Application ID (needed for command registration)
DISCORD_APP_ID=
# Comma-separated guild IDs Mai is allowed to act in (empty = every guild).
# This is the whole-bot allowlist, not just n8n forwarding: in an un-listed
# guild Mai does nothing — no moderation, no chat, no reactions, no welcome,
# no slash commands. Direct messages are allowed only from users who share a
# listed guild with the bot.
DISCORD_GUILD_IDS=
# Welcome messages for new members. Requires the privileged "Server Members
# Intent" (Developer Portal -> Bot) — enabling this without the portal toggle
# makes the gateway login fail.
DISCORD_WELCOME_ENABLED=false

# --- Cloudflare tunnel ---
CLOUDFLARED_TUNNEL_TOKEN=

# --- Runtime ---
# Hours between Mai's rotating custom statuses (fractions ok, e.g. 0.5;
# 0 = pick one status at startup, never rotate)
PRESENCE_ROTATE_HOURS=5
# HTTP port of the interactions endpoint (cloudflared targets http://mai:3000)
PORT=3000
LOG_LEVEL=info
TZ=Europe/Berlin

# --- Discord application (Developer Portal -> your app) ---
# Bot -> Token
DISCORD_BOT_TOKEN=
# General Information -> Public Key (verifies interaction signatures)
DISCORD_PUBLIC_KEY=
# General Information -> Application ID (needed for command registration)
DISCORD_APP_ID=
# Comma-separated guild IDs Mai is allowed to act in (empty = every guild).
# This is the whole-bot allowlist: in an un-listed guild Mai does nothing: no
# moderation, no chat, no reactions, no welcome, no slash commands. Direct
# messages are allowed only from users who share a listed guild with the bot.
DISCORD_GUILD_IDS=
# Welcome messages for new members. Requires the privileged "Server Members
# Intent" (Developer Portal -> Bot): enabling this without the portal toggle
# makes the gateway login fail.
DISCORD_WELCOME_ENABLED=false
# Comma-separated user IDs of whoever runs the bot, as opposed to whoever
# moderates a server that uses it. Only these ids see process-wide numbers in
# /mod status and /mod spend; every other Manage Messages holder sees their own
# guild only. Empty = nobody, so the cross-guild view is off by default.
OPERATOR_USER_IDS=

# --- OpenAI (or any API-compatible provider) ---
# Required as soon as moderation or chat is enabled.
OPENAI_API_KEY=
# Only /chat/completions and /moderations are used, so a compatible endpoint
# works too (note: not every provider implements /moderations).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=30000
# Retries on 429/5xx/timeout. Safe: an API call has no side effects of its own.
OPENAI_MAX_RETRIES=2
# Tokens per calendar month (UTC) before chat degrades to reactions only.
# 0 = no limit. Moderation is never gated by this. See /mod spend.
OPENAI_MONTHLY_TOKEN_BUDGET=0

# --- Moderation ---
MODERATION_ENABLED=true
# Time the author has to delete a flagged message themselves
MODERATION_GRACE_PERIOD_MINUTES=10
# How often due messages are enforced (also prunes the chat history)
MODERATION_TICK_MS=60000
# Most queue rows one tick works through. Rows are handled one at a time
# (several Discord calls each), so this keeps a backlog after an outage from
# outlasting the interval; the rest is picked up by the next tick.
MODERATION_MAX_ROWS_PER_TICK=100
# Also classify image attachments (multimodal moderation input). While this is
# false, a message that carries only an image is not checked at all, there is
# no text to classify.
MODERATION_CLASSIFY_IMAGES=true
# Hand out escalation timeouts at all. Off still records strikes, so /mod history
# stays complete and switching it back on picks up where it left off.
# Per server: /mod config set escalation:false
MODERATION_ESCALATION_ENABLED=true
# Escalation: timeout minutes per strike, 1-based, last step repeats.
# 0 = no timeout, so the default lets a first offence pass with just the
# deletion, then 10 min, 1 h, 24 h. Needs the Moderate Members permission.
MODERATION_TIMEOUT_LADDER=0,10,60,1440
# How far back enforced deletions count towards escalation
MODERATION_STRIKE_WINDOW_DAYS=30
# Minimum category score (0-1) that counts as a violation. 0 = trust the
# provider's own `flagged` boolean, which is what it did before this existed.
#
# Worth raising off 0 for a non-English server: omni-moderation-latest scores
# the same insult 0.88 in English and 0.20 in German, so its own line lets most
# German abuse through. Start around 0.2 and watch /mod history before going
# lower. Per server: /mod config set threshold
MODERATION_THRESHOLD=0
# Comma-separated categories that count at all (empty = every category the
# provider reports), e.g. hate,hate/threatening,sexual/minors.
# Per server: /mod config set categories
MODERATION_CATEGORIES=
# How long the strike record is kept at all (/mod history)
VIOLATION_RETENTION_DAYS=90

# --- Rules Mai applies herself, without a classifier ---
# These cost no tokens, catch what a semantic score cannot (an advertisement is
# a polite invite link, a raid is twenty harmless lines in five seconds) and
# keep working while the provider is down. They are house rules rather than a
# safety floor, so all of them are off by default. Each is per server too:
# /mod config set invite-filter|link-policy|link-domains|mention-cap|flood
#
# Treat Discord invite links (discord.gg/…, discord.com/invite/…) as a violation.
MODERATION_INVITE_FILTER=false
# What to do with links in general: off, or allowlist (only MODERATION_LINK_DOMAINS
# are allowed, everything else counts as a violation).
MODERATION_LINK_POLICY=off
# Comma-separated host names the allowlist permits. Subdomains are covered, so
# example.com also allows cdn.example.com. Bare hosts only, not URLs.
MODERATION_LINK_DOMAINS=
# Most mentions one message may carry (users, roles, @everyone, @here). 0 = off.
MODERATION_MENTION_CAP=0
# Message burst rule as count/seconds: more than `count` messages from the same
# member within that many seconds is a violation. Empty or "off" = off. One
# violation per burst, not one per message.
MODERATION_FLOOD=
# Consecutive failed classifications in one server before its staff are told in
# the log channel that moderation is currently letting everything through
# (moderation fails open on purpose, which is otherwise invisible from Discord).
MODERATION_DEGRADED_AFTER=3

# --- Mai chat (mention / reply / direct message) ---
CHAT_ENABLED=true
# Prior turns handed to the model as context
CHAT_HISTORY_TURNS=12
# Retention of Mai's chat memory
CHAT_HISTORY_MAX_AGE_HOURS=48
CHAT_MAX_REPLY_CHARS=1800
# Let Mai look at image attachments in messages addressed to her
CHAT_VISION_ENABLED=true
CHAT_VISION_MAX_IMAGES=2
# Function calling: she can look up her own moderation queue, server facts and
# the current time instead of guessing. Tools never take model-supplied arguments.
CHAT_TOOLS_ENABLED=true
# AES-256-GCM key for the chat history content/username columns.
# Required when CHAT_ENABLED=true. Generate: openssl rand -base64 32
# Changing it makes existing history unreadable (rows are then skipped).
CHAT_HISTORY_KEY=
# Per-user rate limit for replies
CHAT_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_WINDOW_MS=60000
# Model calls in flight at once, across all channels
CHAT_MAX_CONCURRENT=3

# --- Storage ---
# Must be inside the mai-data volume mount (/data); the rootfs is read-only.
DATABASE_PATH=/data/mai.sqlite

# --- Operations ---
# Channel that receives error/fatal log lines (throttled). Empty = no alerting.
# An operator channel, not a per-guild setting: most failures are process-wide.
ALERT_CHANNEL_ID=

# --- Content config (persona, prompts, scold lines, reactions) ---
# Defaults to the copy baked into the image. Point this at a read-only
# bind-mount to edit Mai's wording without rebuilding.
MAI_CONFIG_PATH=/app/config/mai.yaml

# --- Cloudflare tunnel ---
CLOUDFLARED_TUNNEL_TOKEN=

# --- Runtime ---
# Hours between Mai's rotating custom statuses (fractions ok, e.g. 0.5;
# 0 = pick one status at startup, never rotate)
PRESENCE_ROTATE_HOURS=5
# HTTP port of the interactions endpoint (cloudflared targets http://mai:3000)
PORT=3000
# Caps in front of /interactions, which is reachable from the public internet
# through the tunnel. Every request costs an Ed25519 signature verification, so
# both run before it. Real traffic is a handful of interactions a minute; these
# defaults only bite on a flood. Requests are keyed by CF-Connecting-IP.
INTERACTIONS_RATE_LIMIT_MAX=120
INTERACTIONS_RATE_LIMIT_WINDOW_MS=60000
# Discord's payloads are a few KB. A request without a Content-Length is
# refused rather than streamed.
INTERACTIONS_MAX_BODY_BYTES=65536
# Bearer token for GET /metrics (Prometheus text format). The HTTP server is
# public through the tunnel and these numbers span every guild, so an empty
# token disables the endpoint entirely (404). Generate: openssl rand -hex 32
METRICS_TOKEN=
# Miscellaneous settings
LOG_LEVEL=info
TZ=Europe/Berlin

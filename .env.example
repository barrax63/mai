# --- Discord application (Developer Portal -> your app) ---
# Bot -> Token
DISCORD_BOT_TOKEN=
# General Information -> Public Key (verifies interaction signatures)
DISCORD_PUBLIC_KEY=
# General Information -> Application ID (needed for command registration)
DISCORD_APP_ID=
# Comma-separated guild IDs Mai is allowed to act in (empty = every guild).
# This is the whole-bot allowlist: in an un-listed guild Mai does nothing: no
# moderation, no chat, no reactions, no welcome, no slash commands. Direct
# messages are allowed only from users who share a listed guild with the bot.
DISCORD_GUILD_IDS=
# Says one thing only: the privileged "Server Members Intent" is switched on in
# the Developer Portal (-> Bot). Setting this to true without the portal toggle
# makes the gateway login fail outright, which is why it is off by default.
#
# Two features ride that intent, and both are per-server settings rather than
# variables: greeting new members (/mod config set welcome:true) and screening
# display names (/mod config set name-check). Servers can set either while this
# is false; Mai stores the decision, says plainly that nothing is happening yet,
# and starts doing it the moment you switch this on.
DISCORD_MEMBER_EVENTS=false
# Comma-separated user IDs of whoever runs the bot, as opposed to whoever
# moderates a server that uses it. Only these ids see process-wide numbers in
# /mod status and /mod spend; every other Manage Messages holder sees their own
# guild only. Empty = nobody, so the cross-guild view is off by default.
OPERATOR_USER_IDS=

# --- OpenAI (or any API-compatible provider) ---
# Required as soon as moderation or chat is enabled.
OPENAI_API_KEY=
# Only /chat/completions and /moderations are used, so a compatible endpoint
# works too (note: not every provider implements /moderations).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Tokens per calendar month (UTC) before chat degrades to reactions only.
# 0 = no limit. Moderation is never gated by this. See /mod spend.
OPENAI_MONTHLY_TOKEN_BUDGET=0

# --- Moderation ---
MODERATION_ENABLED=true
# Also classify image attachments (multimodal moderation input). Default true.
# While this is false, a message that carries only an image is not checked at
# all, there is no text to classify, so posting an image walks past moderation.
MODERATION_CLASSIFY_IMAGES=true
# How long the strike record is kept at all (/mod history)
VIOLATION_RETENTION_DAYS=90

# --- What Mai actually enforces is decided per server, not here ---
# The grace period, the timeout ladder, the strike window, the score threshold,
# the category allowlist, and the four rules she applies without a classifier
# (invite links, the link allowlist, the mention cap, the flood rule) are not
# environment variables. A default here would be a decision taken for servers
# whose staff cannot see this file, and it made "why did Mai delete that?" a
# question with three places to look.
#
# In Discord:
#   /mod setup observe|standard|strict   a whole profile, one decision
#   /mod config view                     what this server is doing, and why
#   /mod config set <name> <value>       one value, on top of the profile
#   /mod config reset <name>             back to what the profile says
#
# A new server that never runs any of that has almost everything off, which is
# a floor rather than a recommendation: the recommendation is `/mod setup`, and
# Mai offers it as buttons when she joins. Start with `observe` (a week of
# watching without acting, then she switches herself back and reports what she
# would have done), because the honest threshold for a non-English server is a
# number you read off real traffic: omni-moderation-latest scores the same
# insult 0.88 in English and 0.20 in German.

# --- Appeal evidence ---
# How many hours the text of an enforced message is kept so staff can review an
# appeal against it. 0 = never, and the feature is off everywhere.
#
# This is the second deliberate exception to the no-content rule, so it is
# fenced in: the operator sets the window here, each server still has to opt in
# (/mod config set evidence:true), the text is encrypted with CHAT_HISTORY_KEY,
# it is pruned by the same tick that prunes everything else, and it is only ever
# read back ephemerally by one moderator through a button on the appeal entry,
# never posted into a channel. Setting this back to 0 clears what is left on the
# next tick. Hours, not days: it exists for the appeal window, not as an archive.
MODERATION_EVIDENCE_HOURS=0

# --- Mai chat (mention / reply / direct message) ---
CHAT_ENABLED=true
# Retention of Mai's chat memory
CHAT_HISTORY_MAX_AGE_HOURS=48
# Let Mai look at image attachments in messages addressed to her
CHAT_VISION_ENABLED=true
# Function calling: she can look up her own moderation queue, server facts and
# the current time instead of guessing. Tools never take model-supplied arguments.
CHAT_TOOLS_ENABLED=true
# AES-256-GCM key for every encrypted column in the database: the chat history
# content/username, and the appeal evidence above. Required when CHAT_ENABLED=true
# or MODERATION_EVIDENCE_HOURS is above 0. Generate: openssl rand -base64 32
# Changing it makes existing rows unreadable (they are then skipped and pruned).
CHAT_HISTORY_KEY=

# --- Storage ---
# Must be inside the mai-data volume mount (/data); the rootfs is read-only.
DATABASE_PATH=/data/mai.sqlite

# --- Operations ---
# Channel that receives error/fatal log lines (throttled). Empty = no alerting.
# An operator channel, not a per-guild setting: most failures are process-wide.
ALERT_CHANNEL_ID=

# --- Content config (persona, prompts, scold lines, reactions) ---
# Defaults to the copy baked into the image. Point this at a read-only
# bind-mount to edit Mai's wording without rebuilding.
MAI_CONFIG_PATH=/app/config/mai.yaml

# --- Cloudflare tunnel ---
CLOUDFLARED_TUNNEL_TOKEN=

# --- Runtime ---
# HTTP port of the interactions endpoint (cloudflared targets http://mai:3000)
PORT=3000
# Bearer token for GET /metrics (Prometheus text format). The HTTP server is
# public through the tunnel and these numbers span every guild, so an empty
# token disables the endpoint entirely (404). Generate: openssl rand -hex 32
METRICS_TOKEN=
# Miscellaneous settings
LOG_LEVEL=info
TZ=Europe/Berlin
